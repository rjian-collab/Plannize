{
  "name": "plannize",
  "version": "0.1.0",
  "private": true,
  "description": "Plannize — a frosted-glass personal project manager for Windows (Electron)",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.4.0"
  },
  "author": "rjian-collab",
  "license": "MIT",
  "homepage": "https://github.com/rjian-collab/Plannize",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "Plannize.App",
    "productName": "Plannize",
    "artifactName": "Plannize-Setup-${version}.${ext}",
    "files": [
      "electron-main.js",
      "server.js",
      "google.js",
      "calendar.js",
      "reminders.js",
      "routines.js",
      "preload.js",
      "paths.js",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
